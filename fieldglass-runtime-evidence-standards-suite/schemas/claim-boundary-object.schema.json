    "prohibited_claims"
  ],
  "properties": {
    "observable_only": {
      "type": "boolean"
    },
    "prohibited_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text": {
      "type": "string"
    }
  }
}