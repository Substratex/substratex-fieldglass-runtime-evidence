{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substratex.local/schemas/evidence-bundle.schema.json",
  "title": "Fieldglass Evidence Bundle",
  "type": "object",
  "required": [
    "bundle_id",
    "format",
    "artifacts"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}